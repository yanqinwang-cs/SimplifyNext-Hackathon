# Copy to .env (gitignored) and fill in the values you need, or export them in
# your shell. The API server reads the process environment; only
# scripts/smoke_bedrock.py loads a .env file automatically.

# Model provider: "anthropic" (default) or "bedrock".
CASELENS_MODEL_PROVIDER=anthropic

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=

# Amazon Bedrock (AWS credentials come from your usual AWS setup)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional per-role model overrides
VNEXT_INVESTIGATOR_MODEL_ID=
WORKSPACE_MODEL_ID=

# Comma-separated browser origins allowed to call the API
SIMPLIFYNEXT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Set to 1 only for local debugging of temporary AWS credential overrides
SIMPLIFYNEXT_DEBUG_CREDENTIALS=
